 "verdict": {
  "候補": "f2_rnd_r[上位1/4] ∧ f2_sga_r[下位1/4] / P_full / 勝者側",
  "探索側の弁": "合格（維持lift 0.2953・2018で n=15 分子=11 lift 0.5232）",
  "再現": "できた（探索側の24数値と不一致0・行を直接数えても一致）",
